              "last_analysis_stats": { "malicious": 54, "suspicious": 0, "undetected": 10, "harmless": 0 }
            }
          }
        }
      }
    },
    {
      "priority": 5,
      "request": { "method": "GET", "urlPath": "/ab/check" },
      "response": {
        "status": 200,
        "jsonBody": { "data": { "abuseConfidenceScore": 100, "isWhitelisted": false, "totalReports": 50 } }
      }
    },
    {
      "priority": 5,
      "request": { "method": "GET", "urlPathPattern": "/otx/indicators/.*" },
      "response": { "status": 200, "jsonBody": { "pulse_info": { "count": 3 } } }
    }
  ]
